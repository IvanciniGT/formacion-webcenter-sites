{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "filter": {
        "english_stop_filter": { "type": "stop", "stopwords": "_english_" },
        "english_possessive_stemmer": { "type": "stemmer", "language": "possessive_english" },
        "english_stemmer": { "type": "stemmer", "language": "english" }
      },
      "analyzer": {
        "my_custom_analyser": {
          "type": "custom",
          "char_filter": ["html_strip"],
          "tokenizer": "standard",
          "filter": ["english_possessive_stemmer", "lowercase", "english_stop_filter", "english_stemmer"]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "titulo": { "type": "text", "analyzer": "my_custom_analyser" },
      "cuerpo": { "type": "text", "analyzer": "my_custom_analyser" },
      "deporte": { "type": "keyword" },
      "autor": { "type": "keyword" },
      "etiquetas": { "type": "keyword" },
      "fecha": { "type": "date", "format": "yyyy-MM-dd" },
      "visitas": { "type": "integer" },
      "destacado": { "type": "boolean" }
    }
  }
}
